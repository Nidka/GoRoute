<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Permite tráfico HTTP (cleartext) solo hacia el backend de desarrollo.
        10.0.2.2  = localhost del host cuando se corre en emulador Android.
        10.0.3.2  = localhost en Genymotion.
        En producción este archivo NO incluye dominios con cleartext.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Todo lo demás (producción) → solo HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
